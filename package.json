{
  "name": "selection-translator-extension",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "displayName": "Easy Translate",
  "description": "Easy Translate (ET)：在 VS Code 编辑器中翻译选区，支持 OpenAI 兼容接口、有道、百度、DeepL 和 Google。",
  "publisher": "selection-translator",
  "icon": "public/icons/icon-256.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist-vscode/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "selectionTranslator.translate",
        "title": "翻译选中内容",
        "category": "ET"
      },
      {
        "command": "selectionTranslator.manageEngines",
        "title": "管理翻译引擎",
        "category": "ET"
      },
      {
        "command": "selectionTranslator.selectDefaultEngine",
        "title": "选择默认翻译引擎",
        "category": "ET"
      },
      {
        "command": "selectionTranslator.setTargetLanguage",
        "title": "设置目标语言",
        "category": "ET"
      },
      {
        "command": "selectionTranslator.cancelTranslation",
        "title": "取消当前翻译",
        "category": "ET"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "selectionTranslator.translate",
          "when": "editorHasSelection",
          "group": "selectionTranslator@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "selectionTranslator.cancelTranslation",
        "key": "escape",
        "when": "editorTextFocus && selectionTranslator.hasTranslation"
      }
    ],
    "configuration": {
      "title": "Easy Translate (ET)",
      "properties": {
        "selectionTranslator.targetLanguage": {
          "type": "string",
          "default": "简体中文",
          "description": "默认目标语言，可填写语言名称或语言代码。"
        },
        "selectionTranslator.autoTranslate": {
          "type": "boolean",
          "default": true,
          "description": "选中文本后自动在选区附近显示悬浮翻译。可通过状态栏的“ET 划词翻译”按钮随时开关；关闭后仍可使用右键菜单或命令面板手动翻译。"
        },
        "selectionTranslator.hoverAutoHideDelay": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "maximum": 60000,
          "description": "选区取消后悬浮翻译的延迟关闭时间（毫秒），0 表示立即关闭；固定浮窗后不自动关闭。"
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vscode:extension": "vite build --config vite.vscode.config.ts",
    "build:vscode:webview": "vite build --config vite.webview.config.ts",
    "build:vscode": "npm run build:vscode:extension && npm run build:vscode:webview",
    "package:vscode": "npm run build:vscode && vsce package --no-dependencies --allow-missing-repository -o easy-translate.vsix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-md5": "0.11.0",
    "undici": "5.29.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.80.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vscode/vsce": "^4.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
